# --- Required ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets; print(secrets.token_hex(32))"
COMPOSIO_API_KEY=
AGENTGUARD_API_KEY=

# --- LLM providers: set at least one. Order of use: DeepSeek -> OpenRouter -> Cerebras ---
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Restrict the cascade (e.g. keep private data off free tiers): LUCE_PROVIDERS=deepseek
LUCE_PROVIDERS=

# --- Deployment ---
LUCE_ENV=development            # "production" enables Secure cookies
PORT=10000
LUCE_DB_PATH=                   # point to a persistent volume in production
PUBLIC_BASE_URL=                # public URL of this API (used for the OAuth callback)
FRONTEND_URL=/connexions        # where users land after OAuth
FRONTEND_ORIGINS=               # only if the frontend is on ANOTHER origin (comma separated)
# SESSION_COOKIE_SAMESITE=Lax   # automatically "None" when FRONTEND_ORIGINS is set

# --- Limits ---
LUCE_CHAT_RATE_LIMIT=20
LUCE_CHAT_RATE_WINDOW=60
LUCE_MAX_MESSAGE_CHARS=4000
LUCE_HISTORY_LIMIT=30

# --- Cerbere / AgentGuard ---
AGENTGUARD_COLLECTOR_URL=https://agentguard-aqal.onrender.com
AGENTGUARD_MAX_BUDGET=10.0
AGENTGUARD_DEBUG=false

# --- Frontend (Vite) ---
# LUCE_API_TARGET=http://127.0.0.1:10000   # dev proxy target
# VITE_API_URL=                            # only if the API is on another origin
